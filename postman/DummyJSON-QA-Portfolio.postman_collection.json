{
  "info": {
    "name": "DummyJSON API — QA Portfolio",
    "description": "Executable API QA portfolio by Tetiana Hil. Covers auth, JSON Schema validation, products, pagination boundaries, search, sorting, mutation contracts and negative/status scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Authentication",
      "item": [
        {
          "name": "AUTH-01 Login — valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"expiresInMins\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const json = pm.response.json();",
                  "pm.test('Tokens are returned', () => { pm.expect(json.accessToken).to.be.a('string').and.not.empty; pm.expect(json.refreshToken).to.be.a('string').and.not.empty; });",
                  "pm.test('Correct user is returned', () => pm.expect(json.username).to.eql(pm.environment.get('username')));",
                  "const loginSchema = { type: 'object', required: ['id','username','email','accessToken','refreshToken'], properties: { id:{type:'number'}, username:{type:'string'}, email:{type:'string'}, accessToken:{type:'string'}, refreshToken:{type:'string'} } };",
                  "pm.test('Login response matches JSON Schema', () => pm.response.to.have.jsonSchema(loginSchema));",
                  "pm.environment.set('accessToken', json.accessToken); pm.environment.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AUTH-02 Login — invalid password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid login is rejected', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('No access token is issued', () => pm.expect(json.accessToken).to.be.undefined);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AUTH-03 Current authenticated user",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Authenticated identity matches login', () => pm.expect(json.username).to.eql(pm.environment.get('username')));",
                  "pm.test('Core identity fields exist', () => { pm.expect(json.id).to.be.a('number'); pm.expect(json.email).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AUTH-04 Current user — invalid Bearer token",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJxYS1wb3J0Zm9saW8iLCJleHAiOjQ3MjIzNjQ4MDB9.invalidsignature",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid token does not return a successful authenticated response', () => pm.expect(pm.response.code).to.not.eql(200));",
                  "pm.test('Protected endpoint does not expose authenticated profile', () => { const json=pm.response.json(); pm.expect(json.username).to.be.undefined; pm.expect(json.id).to.be.undefined; });",
                  "pm.test('Observed SUT status is an auth rejection or documented anomaly', () => pm.expect(pm.response.code).to.be.oneOf([401,403,500]));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Products",
      "item": [
        {
          "name": "PROD-01 Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Product ID is 1', () => pm.expect(json.id).to.eql(1));",
                  "pm.test('Core product contract', () => { pm.expect(json.title).to.be.a('string'); pm.expect(json.price).to.be.a('number'); pm.expect(json.category).to.be.a('string'); });",
                  "const productSchema = { type:'object', required:['id','title','price','category'], properties:{ id:{type:'number'}, title:{type:'string'}, price:{type:'number'}, category:{type:'string'} } };",
                  "pm.test('Product response matches JSON Schema', () => pm.response.to.have.jsonSchema(productSchema));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-02 Nonexistent product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-03 Pagination limit and skip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5&skip=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Requested pagination is respected', () => { pm.expect(json.products.length).to.be.at.most(5); pm.expect(json.skip).to.eql(10); pm.expect(json.limit).to.eql(5); });",
                  "const listSchema = { type:'object', required:['products','total','skip','limit'], properties:{ products:{type:'array'}, total:{type:'number'}, skip:{type:'number'}, limit:{type:'number'} } };",
                  "pm.test('Product list matches JSON Schema', () => pm.response.to.have.jsonSchema(listSchema));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-04 Empty page beyond dataset",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5&skip=999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "999999"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json=pm.response.json();",
                  "pm.test('Out-of-range page is empty', () => { pm.expect(json.products).to.be.an('array').that.is.empty; pm.expect(json.skip).to.eql(999999); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-05 Zero limit boundary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json=pm.response.json();",
                  "pm.test('limit=0 returns all items according to DummyJSON contract', () => { pm.expect(json.products).to.be.an('array'); pm.expect(json.products.length).to.eql(json.total); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-06 Search with no matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=qa-portfolio-no-such-product-987654",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "qa-portfolio-no-such-product-987654"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json=pm.response.json();",
                  "pm.test('No-match search returns empty collection', () => { pm.expect(json.products).to.be.an('array').that.is.empty; pm.expect(json.total).to.eql(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-04 Search products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "phone"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Products collection is returned', () => pm.expect(json.products).to.be.an('array'));",
                  "pm.test('Returned products match search text', () => json.products.forEach(p => pm.expect((p.title + ' ' + (p.description || '')).toLowerCase()).to.include('phone')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-05 Sort title ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?sortBy=title&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "title"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Titles are sorted ascending', () => { const titles=json.products.map(p=>p.title); const sorted=[...titles].sort((a,b)=>a.localeCompare(b)); pm.expect(titles).to.eql(sorted); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-06 Add product — contract only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "add"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Portfolio Test Product\",\n  \"price\": 42.5,\n  \"category\": \"qa-demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create response is successful', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const json = pm.response.json();",
                  "pm.test('Submitted fields are echoed and ID generated', () => { pm.expect(json.title).to.eql('QA Portfolio Test Product'); pm.expect(json.price).to.eql(42.5); pm.expect(json.id).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-07 Patch product — contract only",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Portfolio Updated Title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Updated title is returned', () => pm.expect(json.title).to.eql('QA Portfolio Updated Title'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PROD-08 Delete product — contract only",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Deletion metadata is returned', () => { pm.expect(json.isDeleted).to.eql(true); pm.expect(json.deletedOn).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
